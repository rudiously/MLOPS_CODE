{
  "id": null,
  "uid": "codesentinel-overview",
  "title": "CodeSentinel Overview",
  "tags": ["codesentinel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "API requests per second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (route) (rate(codesentinel_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "API p95 latency (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(codesentinel_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "Model inference p95 latency (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(codesentinel_model_inference_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "Scans by outcome",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "sum by (outcome) (increase(codesentinel_scans_total[1h]))", "legendFormat": "{{outcome}}", "refId": "A"}]
    },
    {
      "id": 5,
      "title": "API errors per second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [{"expr": "sum(rate(codesentinel_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx", "refId": "A"}]
    }
  ]
}
